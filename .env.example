# ==============================================================================
# Orchify - Environment Configuration Template
# ==============================================================================
# Duplicate this file as `.env` and fill in the appropriate secrets before starting.
# Never commit `.env` containing real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database. If using Neon, ensure `sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Better-Auth)
# ------------------------------------------------------------------------------
# Random 32+ character string used to sign session cookies and JWTs.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-random-32-char-better-auth-secret-key"

# Canonical URL of your application backend for Better-Auth callback routing.
# In local development, use: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Public URL used on client components (e.g., webhook generator dialogs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. OAuth Providers (GitHub & Google)
# ------------------------------------------------------------------------------
# GitHub OAuth App credentials (https://github.com/settings/developers)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Optional: Google OAuth credentials (if configured in better-auth social providers)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ------------------------------------------------------------------------------
# 4. Inngest Workflow Orchestration
# ------------------------------------------------------------------------------
# Inngest Event Key used to dispatch background execution events
# In local development with Inngest CLI, these can be set to local placeholders.
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY="your_inngest_signing_key"

# Optional: Inngest Base URL for self-hosted / enterprise proxies (defaults to cloud)
# INNGEST_BASE_URL="https://api.inngest.com"

# ------------------------------------------------------------------------------
# 5. Security & Vault Credential Encryption (Cryptr)
# ------------------------------------------------------------------------------
# High-entropy encryption passphrase used by Cryptr (AES-256-GCM)
# This key encrypts third-party LLM API keys (OpenAI, Gemini, Anthropic) in the DB.
# WARNING: Changing this key invalidates previously encrypted credentials in the database!
ENCRYPTION_KEY="your-secure-high-entropy-encryption-passphrase-32-chars"

# ------------------------------------------------------------------------------
# 6. Billing & Subscription Management (Polar.sh)
# ------------------------------------------------------------------------------
# Organization Personal Access Token from Polar (https://polar.sh/settings)
POLAR_ACCESS_TOKEN="polar_oat_your_polar_access_token"

# Target redirect URL after successful checkout completion
POLAR_SUCCESS_URL="http://localhost:3000"

# Optional: Webhook secret for Polar webhook verification
POLAR_WEBHOOK_SECRET="your_polar_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 7. Local Tunneling (ngrok)
# ------------------------------------------------------------------------------
# Required for receiving external webhooks (e.g., Stripe, Google Forms) in local dev.
# Assigned static domain or ephemeral URL from ngrok (e.g., https://abc-123.ngrok-free.app)
NGROK_URL="https://your-ngrok-subdomain.ngrok-free.app"

# ------------------------------------------------------------------------------
# 8. Observability & Error Tracking (Sentry)
# ------------------------------------------------------------------------------
# Sentry authentication token for uploading release sourcemaps during build
SENTRY_AUTH_TOKEN="sntrys_your_sentry_auth_token"
NEXT_PUBLIC_SENTRY_DSN="https://your-public-key@o0.ingest.sentry.io/0000000"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="orchify"
